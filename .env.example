# Groq API Key for the Portfolio Agent
# 1. On Vercel: Set GROQ_API_KEY in your Vercel Project Settings > Environment Variables
# 2. For local testing with Vite: You can optionally set VITE_GROQ_API_KEY in a local .env file
GROQ_API_KEY=gsk_your_groq_api_key_here
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here
